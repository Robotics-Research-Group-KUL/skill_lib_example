                    "guarded_motion_frame": "world_frame",
                    "K_F": [20000, 20000, 1500],
                    "K_T": [200, 200, 200],
                    "maxvel": 0.5,
                    "task_frame": "tcp_frame",
                    "tf_2_insframe": [0, 0, 0, 0, 0, 0, 1],
                    "time_delay": 1.0,
                    "tool_COG": [0, 0, 0],
                    "tool_weight": 0.0
                }
            }
        },
        {
            "name": "GuardedDownPlace",
